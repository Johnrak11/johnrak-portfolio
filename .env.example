# ─────────────────────────────────────────────────────────────
# Portfolio deployment settings.
#
# SITE_ADDRESS and ACME_EMAIL are gone: the edge proxy in the infra
# repo owns hostnames and TLS certificates now.
#
# In production CI builds the image and supplies the VITE_* values
# from GitHub secrets, so this file is only needed for local work
# and for BUILD_LOCALLY=1 ./deploy.sh
# ─────────────────────────────────────────────────────────────
APP_ENV=production

GHCR_IMAGE=johnrak11/johnrak-portfolio
IMAGE_TAG=latest

# ─────────────────────────────────────────────────────────────
# WARNING: Vite inlines every VITE_* value into the JavaScript
# bundle at build time. Anything below is readable by any visitor
# through view-source. Never put a real credential here.
# ─────────────────────────────────────────────────────────────

# Where the admin API lives. Baked in at build time, so changing the
# domain means rebuilding the image.
VITE_ADMIN_API_BASE_URL=https://admin.johnrak.online

# API token for the admin's /api/client/* routes — both the profile sync and
# the AI chat. Generate it in the admin panel under Security & Tokens; the raw
# value is shown once, at creation, and cannot be retrieved afterwards.
#
# In CI this comes from the repository *variable* of the same name, not a
# secret: the value ships in the public bundle anyway, and a secret cannot be
# read back — which would make drift from the admin's token invisible.
#
# Rotating it means creating a new token, updating that variable, rebuilding
# this image, then revoking the old token. The admin backend needs no redeploy.
#
# Empty means the sync is skipped with a console warning and the chat gets 401.
VITE_PORTFOLIO_API_TOKEN=
