# ─────────────────────────────────────────────────────────────
# Portfolio deployment settings.
#
# SITE_ADDRESS and ACME_EMAIL are gone: the edge proxy in the infra
# repo owns hostnames and TLS certificates now.
#
# In production CI builds the image and supplies the VITE_* values
# from GitHub secrets, so this file is only needed for local work
# and for BUILD_LOCALLY=1 ./deploy.sh
# ─────────────────────────────────────────────────────────────
APP_ENV=production

GHCR_IMAGE=johnrak11/johnrak-portfolio
IMAGE_TAG=latest

# ─────────────────────────────────────────────────────────────
# WARNING: Vite inlines every VITE_* value into the JavaScript
# bundle at build time. Anything below is readable by any visitor
# through view-source. Never put a real credential here.
# ─────────────────────────────────────────────────────────────

# Where the admin API lives. Baked in at build time, so changing the
# domain means rebuilding the image.
VITE_ADMIN_API_BASE_URL=https://admin.johnrak.online

# Must match PORTFOLIO_SHARED_SECRET in the admin's backend/.env, or
# src/lib/profileStore.ts skips the profile sync with only a console
# warning.
VITE_PORTFOLIO_SHARED_SECRET=
